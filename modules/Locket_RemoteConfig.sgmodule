#!name=Locket-XVIP (Super VIP Pro Max)
#!desc=Kích hoạt Locket Gold trọn đời (RevenueCat) + 4K Ultra HD + 30s Video + Vô hạn bạn bè + Ai đã xem + Khôi phục Streak + Chặn QC (Firebase). By duckzangryy
#!category=duckzangryy VIP
#!system=ios

[Script]
# --- 1. REVENUECAT: Mở khóa Locket Gold trọn đời ---
locket_rc_response = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.*\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/duckzangryy/Locket-XVIP/main/js/locket_revenuecat_response.js, requires-body=true, max-size=-1, timeout=120
locket_rc_request = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.*\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/duckzangryy/Locket-XVIP/main/js/locket_revenuecat_request.js, timeout=120

# --- 2. FIREBASE: Mở khóa 4K, 30s Video, Vô hạn bạn bè, Khung hình VIP & Chặn QC ---
locket_firebase_response = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/.*\/namespaces\/firebase:fetch, script-path=https://raw.githubusercontent.com/duckzangryy/Locket-XVIP/main/js/locket_firebase_response.js, requires-body=true, max-size=-1, timeout=60
locket_firebase_request = type=http-request, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/.*\/namespaces\/firebase:fetch, script-path=https://raw.githubusercontent.com/duckzangryy/Locket-XVIP/main/js/locket_firebase_request.js, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com, raw.githubusercontent.com
