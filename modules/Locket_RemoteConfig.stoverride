name: Locket-XVIP (Super VIP Pro Max)
desc: Kích hoạt Locket Gold trọn đời (RevenueCat) + 4K Ultra HD + 30s Video + Vô hạn bạn bè + Ai đã xem + Khôi phục Streak + Chặn QC (Firebase). By duckzangryy

http:
  mitm:
    - "api.revenuecat.com"
    - "firebaseremoteconfig.googleapis.com"
  script:
    - match: ^https:\/\/api\.revenuecat\.com\/.*\/(receipts|subscribers)
      name: locket_rc_request
      type: request
      timeout: 120
      script-path: https://raw.githubusercontent.com/duckzangryy/Locket-XVIP/main/js/locket_revenuecat_request.js
    - match: ^https:\/\/api\.revenuecat\.com\/.*\/(receipts$|subscribers\/[^/]+$)
      name: locket_rc_response
      type: response
      require-body: true
      max-size: -1
      timeout: 120
      script-path: https://raw.githubusercontent.com/duckzangryy/Locket-XVIP/main/js/locket_revenuecat_response.js
    - match: ^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/namespaces\/firebase:fetch
      name: locket_firebase_request
      type: request
      require-body: true
      max-size: -1
      script-path: https://raw.githubusercontent.com/duckzangryy/Locket-XVIP/main/js/locket_firebase_request.js
    - match: ^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/namespaces\/firebase:fetch
      name: locket_firebase_response
      type: response
      require-body: true
      max-size: -1
      script-path: https://raw.githubusercontent.com/duckzangryy/Locket-XVIP/main/js/locket_firebase_response.js
