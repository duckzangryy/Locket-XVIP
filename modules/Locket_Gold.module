#!name=Locket-Gold (Stable)
#!desc=Kích hoạt Locket Gold trọn đời (RevenueCat Pure Stable). By duckzangryy
#!category=duckzangryy VIP

[General]
user-agent = Locket/1.0.0 (iPhone; iOS 26; Scale/3.00)

[Script]
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.*\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/duckzangryy/Locket-XVIP/main/js/locket_revenuecat_response.js, requires-body=true, max-size=-1, timeout=120
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.*\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/duckzangryy/Locket-XVIP/main/js/locket_revenuecat_request.js, timeout=120

[MITM]
hostname = api.revenuecat.com, raw.githubusercontent.com
