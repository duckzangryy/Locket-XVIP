#!name = Locket-XVIP (Super VIP Pro Max)
#!desc = Kích hoạt Locket Gold trọn đời (RevenueCat) + 4K Ultra HD + 30s Video + Vô hạn bạn bè + Ai đã xem + Khôi phục Streak + Chặn QC (Firebase). By duckzangryy
#!author = duckzangryy
#!homepage = https://github.com/duckzangryy/Locket-XVIP
#!icon = https://raw.githubusercontent.com/duckzangryy/Locket-XVIP/main/icon.png

[Script]
http-response ^https:\/\/api\.revenuecat\.com\/.*\/(receipts$|subscribers\/[^/]+$) script-path=https://raw.githubusercontent.com/duckzangryy/Locket-XVIP/main/js/locket_revenuecat_response.js, requires-body=true, timeout=120, tag=Locket_RC_Response
http-request ^https:\/\/api\.revenuecat\.com\/.*\/(receipts|subscribers) script-path=https://raw.githubusercontent.com/duckzangryy/Locket-XVIP/main/js/locket_revenuecat_request.js, timeout=120, tag=Locket_RC_Request

http-response ^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/.*\/namespaces\/firebase:fetch script-path=https://raw.githubusercontent.com/duckzangryy/Locket-XVIP/main/js/locket_firebase_response.js, requires-body=true, timeout=60, tag=Locket_Firebase_Response
http-request ^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/.*\/namespaces\/firebase:fetch script-path=https://raw.githubusercontent.com/duckzangryy/Locket-XVIP/main/js/locket_firebase_request.js, timeout=60, tag=Locket_Firebase_Request

[Mitm]
hostname = api.revenuecat.com, firebaseremoteconfig.googleapis.com, raw.githubusercontent.com
