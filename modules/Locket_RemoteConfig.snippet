# Locket-XVIP (Super VIP Pro Max) for Quantumult X
# By duckzangryy

[rewrite_remote]

[rewrite_local]
^https:\/\/api\.revenuecat\.com\/.*\/(receipts$|subscribers\/[^/]+$) url script-response-body https://raw.githubusercontent.com/duckzangryy/Locket-XVIP/main/js/locket_revenuecat_response.js
^https:\/\/api\.revenuecat\.com\/.*\/(receipts|subscribers) url script-request-header https://raw.githubusercontent.com/duckzangryy/Locket-XVIP/main/js/locket_revenuecat_request.js

^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/.*\/namespaces\/firebase:fetch url script-response-body https://raw.githubusercontent.com/duckzangryy/Locket-XVIP/main/js/locket_firebase_response.js
^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/.*\/namespaces\/firebase:fetch url script-request-body https://raw.githubusercontent.com/duckzangryy/Locket-XVIP/main/js/locket_firebase_request.js

[mitm]
hostname = api.revenuecat.com, firebaseremoteconfig.googleapis.com, raw.githubusercontent.com
